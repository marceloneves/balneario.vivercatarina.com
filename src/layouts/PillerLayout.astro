---
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import WhatsAppLeadGate from '../components/WhatsAppLeadGate.astro';
import { versionedAsset } from '../lib/asset-version.mjs';
import { SITE_NAME } from '../lib/site-contact.mjs';
import { resolvePageSeo } from '../lib/site-seo.mjs';
import {
	breadcrumbListFromItems,
	buildBreadcrumbSchema,
	buildOrganizationSchema,
	buildWebSiteSchema,
} from '../lib/site-schema.mjs';

interface BreadcrumbItem {
	name: string;
	url: string;
}

interface Props {
	title: string;
	description?: string;
	keywords?: string;
	bodyClass?: string;
	disableEffects?: boolean;
	asyncFonts?: boolean;
	slimScripts?: boolean;
	preloadImage?: string;
	stylesheets?: string[];
	ogImage?: string;
	ogType?: string;
	canonicalPath?: string;
	noindex?: boolean;
	jsonLd?: Record<string, unknown>[];
	breadcrumb?: BreadcrumbItem[];
}

const {
	title,
	description,
	keywords,
	bodyClass = '',
	disableEffects = false,
	asyncFonts = false,
	slimScripts = false,
	preloadImage,
	stylesheets = [],
	ogImage,
	ogType,
	canonicalPath,
	noindex,
	jsonLd = [],
	breadcrumb,
} = Astro.props;

const seo = resolvePageSeo({
	title,
	description,
	keywords,
	pathname: Astro.url.pathname,
	ogImage,
	ogType,
	canonicalPath,
	noindex,
});

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const resolvedBodyClass = isHomePage
	? ['home-page', bodyClass].filter(Boolean).join(' ')
	: [bodyClass, 'site-dark-header'].filter(Boolean).join(' ');
const deferredStylesheets = slimScripts
	? ['/assets/css/bootstrap.min.css', '/assets/css/style.css', '/css/internal-links.css']
	: [];

const isNoindex = seo.robots.includes('NOINDEX');
const breadcrumbSchema = isNoindex
	? null
	: breadcrumb && breadcrumb.length
		? breadcrumbListFromItems(breadcrumb)
		: buildBreadcrumbSchema(Astro.url.pathname, title);
const structuredData = [
	buildOrganizationSchema(),
	buildWebSiteSchema(),
	breadcrumbSchema,
	...jsonLd,
].filter(Boolean);
---

<!doctype html>
<html class="no-js" lang="pt-BR">
	<head>
		<meta charset="utf-8" />
		<meta http-equiv="x-ua-compatible" content="ie=edge" />
		<title>{seo.title}</title>
		<meta name="author" content={seo.author} />
		<meta name="publisher" content={seo.publisher} />
		<meta name="description" content={seo.description} />
		<meta name="keywords" content={seo.keywords} />
		<meta name="robots" content={seo.robots} />
		<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={seo.canonicalUrl} />
		<meta property="og:locale" content="pt_BR" />
		<meta property="og:site_name" content={SITE_NAME} />
		<meta property="og:title" content={seo.ogTitle} />
		<meta property="og:description" content={seo.ogDescription} />
		<meta property="og:type" content={seo.ogType} />
		<meta property="og:url" content={seo.ogUrl} />
		<meta property="og:image" content={seo.ogImage} />
		<meta property="og:image:alt" content={seo.ogImageAlt} />
		{seo.ogImageWidth && <meta property="og:image:width" content={String(seo.ogImageWidth)} />}
		{seo.ogImageHeight && <meta property="og:image:height" content={String(seo.ogImageHeight)} />}
		<meta name="twitter:card" content={seo.twitterCard} />
		<meta name="twitter:title" content={seo.ogTitle} />
		<meta name="twitter:description" content={seo.ogDescription} />
		<meta name="twitter:image" content={seo.ogImage} />
		<meta name="twitter:image:alt" content={seo.ogImageAlt} />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

		<link rel="apple-touch-icon" sizes="57x57" href="/assets/img/favicons/apple-icon-57x57.png" />
		<link rel="apple-touch-icon" sizes="60x60" href="/assets/img/favicons/apple-icon-60x60.png" />
		<link rel="apple-touch-icon" sizes="72x72" href="/assets/img/favicons/apple-icon-72x72.png" />
		<link rel="apple-touch-icon" sizes="76x76" href="/assets/img/favicons/apple-icon-76x76.png" />
		<link rel="apple-touch-icon" sizes="114x114" href="/assets/img/favicons/apple-icon-114x114.png" />
		<link rel="apple-touch-icon" sizes="120x120" href="/assets/img/favicons/apple-icon-120x120.png" />
		<link rel="apple-touch-icon" sizes="144x144" href="/assets/img/favicons/apple-icon-144x144.png" />
		<link rel="apple-touch-icon" sizes="152x152" href="/assets/img/favicons/apple-icon-152x152.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/assets/img/favicons/apple-icon-180x180.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/assets/img/favicons/android-icon-192x192.png" />
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/img/favicons/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="96x96" href="/assets/img/favicons/favicon-96x96.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/img/favicons/favicon-16x16.png" />
		<link rel="manifest" href="/assets/img/favicons/manifest.json" />
		<meta name="msapplication-TileColor" content="#ffffff" />
		<meta name="msapplication-TileImage" content="/assets/img/favicons/ms-icon-144x144.png" />
		<meta name="theme-color" content="#FFAF00" />

		{
			preloadImage && (
				<link rel="preload" as="image" href={preloadImage} fetchpriority="high" />
			)
		}
		<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/bebas-neue-latin.woff2" crossorigin />
		<link rel="preload" as="font" type="font/woff2" href="/assets/fonts/fraunces-italic-latin.woff2" crossorigin />
		<link rel="stylesheet" href={versionedAsset('/css/fonts.css')} />

		{
			slimScripts ? (
				<>
					{deferredStylesheets.map((href) => (
						<>
							<link rel="preload" as="style" href={versionedAsset(href)} />
							<link rel="stylesheet" href={versionedAsset(href)} media="print" onload="this.media='all'" />
						</>
					))}
				</>
			) : (
				<>
					<link rel="stylesheet" href={versionedAsset('/assets/css/bootstrap.min.css')} />
					<link rel="stylesheet" href={versionedAsset('/assets/css/style.css')} />
				</>
			)
		}
		{/* FontAwesome não-bloqueante: ícones não são críticos para o render above-the-fold. */}
		<link rel="preload" as="style" href={versionedAsset('/assets/css/fontawesome.min.css')} />
		<link rel="stylesheet" href={versionedAsset('/assets/css/fontawesome.min.css')} media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href={versionedAsset('/assets/css/fontawesome.min.css')} /></noscript>
		{!disableEffects && <link rel="stylesheet" href={versionedAsset('/assets/css/magnific-popup.min.css')} />}
		{!disableEffects && <link rel="stylesheet" href={versionedAsset('/assets/css/swiper-bundle.min.css')} />}
		{stylesheets.map((href) => (
			<link rel="stylesheet" href={versionedAsset(href)} />
		))}
		<link rel="stylesheet" href={versionedAsset('/css/typography-system.css')} />
		<link rel="stylesheet" href={versionedAsset('/css/piller-layout-global.css')} />
		{disableEffects && <link rel="stylesheet" href={versionedAsset('/css/piller-layout-disable-effects.css')} />}
		{structuredData.map((schema) => (
			<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		))}
		<slot name="head" />
		<script is:inline src="/js/site-blog-nav.js" defer></script>
	</head>
	<body class={resolvedBodyClass}>
		<a class="skip-link" href="#conteudo-principal">Ir para o conteúdo</a>
		<slot />
		<WhatsAppLeadGate />
		<WhatsAppFloat />

		<script is:inline src="/assets/js/vendor/jquery-3.7.1.min.js"></script>
		{!disableEffects && <script is:inline src="/assets/js/swiper-bundle.min.js"></script>}
		<script is:inline src="/assets/js/bootstrap.min.js"></script>
		{!disableEffects && <script is:inline src="/assets/js/jquery.magnific-popup.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/jquery.counterup.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/tilt.jquery.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/imagesloaded.pkgd.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/isotope.pkgd.min.js"></script>}
		{!slimScripts && <script is:inline src="/assets/js/jquery-ui.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/lenis.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/360.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/panolens.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/wow.min.js"></script>}
		{!slimScripts && <script is:inline src="/assets/js/nice-select.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/gsap.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/ScrollTrigger.min.js"></script>}
		{!disableEffects && <script is:inline src="/assets/js/SplitText.min.js"></script>}
		{disableEffects && (
			<script is:inline>
				window.WOW = function () {
					return { init: function () {} };
				};
			</script>
		)}
		<script is:inline>
			window.addEventListener('DOMContentLoaded', function () {
				document.querySelectorAll('.color-scheme, .switchIcon').forEach(function (element) {
					element.remove();
				});

				document.querySelectorAll('.th-menu-wrapper a[href^="/"]').forEach(function (menuLink) {
					menuLink.addEventListener('click', function () {
						var menu = document.querySelector('.th-menu-wrapper.th-body-visible');

						if (menu) {
							menu.classList.remove('th-body-visible');
						}
					});
				});
			});
		</script>
		<script is:inline src="/assets/js/main.js"></script>
	</body>
</html>

---
interface Props {
	pageLabel: string;
	parent?: { href: string; label: string };
	overlay?: boolean;
}

const { pageLabel, parent, overlay = false } = Astro.props;
const wrapperClass = [
	'breadcumb-wrapper',
	'single-inventory',
	overlay ? 'breadcumb-wrapper--hero-overlay' : '',
]
	.filter(Boolean)
	.join(' ');
---

<nav class={wrapperClass} aria-label="Trilha de navegação">
	{
		overlay ? (
			<div class="breadcumb-content">
				<ol class="breadcumb-menu">
					<li><a href="/">Início</a></li>
					{
						parent && (
							<li>
								<a href={parent.href}>{parent.label}</a>
							</li>
						)
					}
					<li><span aria-current="page">{pageLabel}</span></li>
				</ol>
			</div>
		) : (
			<div class="container">
				<div class="breadcumb-content">
					<ol class="breadcumb-menu">
						<li><a href="/">Início</a></li>
						{
							parent && (
								<li>
									<a href={parent.href}>{parent.label}</a>
								</li>
							)
						}
						<li><span aria-current="page">{pageLabel}</span></li>
					</ol>
				</div>
			</div>
		)
	}
</nav>

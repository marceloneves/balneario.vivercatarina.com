---
import { toTitleCase } from '../lib/title-case.mjs';
import PropertyOffPlanGuideDownloadCta from './PropertyOffPlanGuideDownloadCta.astro';

const { layout = 'default', page } = Astro.props;
const useSplitLayout = layout === 'split';
const propertySlug = page?.slug ?? null;
const propertyTitle = page?.seo?.h1 ?? null;
const neighborhood = page?.nav?.neighborhood ?? 'Balneário Camboriú';
const city = page?.nav?.city ?? 'Balneário Camboriú';
const construtoraName = page?.construtora?.articleName ?? null;

const groups = [
	{
		title: 'Antes da compra',
		intro: construtoraName
			? `Para comprar o <strong>${propertyTitle}</strong>, você escolhe a unidade, faz a reserva e formaliza o contrato com a <strong>${construtoraName}</strong>. Já nessa fase, vale conferir o <strong>Registro de Incorporação</strong>.`
			: `Nesta fase, você escolhe a unidade do <strong>${propertyTitle}</strong>, reserva o imóvel e formaliza o contrato com a <strong>incorporadora</strong> antes de iniciar os pagamentos da obra.`,
		image: {
			src: '/images/vivercatarina/antes-da-compra-na-planta.webp',
			alt: `Casal analisando plantas do ${propertyTitle} com consultor imobiliário antes da compra`,
		},
		items: [
			{
				title: 'Escolha da unidade',
				paragraphs: [`Escolha planta, andar, metragem e vagas no <strong>${propertyTitle}</strong>.`],
			},
			{
				title: 'Reserva da unidade',
				paragraphs: ['Reserve enquanto analisa as condições e o <strong>Registro de Incorporação</strong>.'],
			},
			{
				title: 'Proposta e contrato',
				paragraphs: ['Assine proposta e contrato com todos os valores conferidos.'],
			},
		],
	},
	{
		title: 'Durante a construção',
		intro: `Com o contrato assinado, começam os pagamentos e o acompanhamento da obra do <strong>${propertyTitle}</strong> em <strong>${neighborhood}</strong>. O prazo de entrega fica registrado em contrato — atrasos geram multa contratual.`,
		image: {
			src: '/images/vivercatarina/durante-a-construcao-na-planta.webp',
			alt: `Casal com capacete acompanhando a construção do ${propertyTitle} em ${neighborhood}`,
		},
		items: [
			{
				title: 'Pagamentos na obra',
				paragraphs: ['Pague entrada, mensais e reforços conforme o cronograma do empreendimento.'],
			},
			{
				title: 'Correção pelo INCC',
				paragraphs: ['Preveja a correção pelo <strong>INCC</strong> sobre as parcelas até a entrega.'],
			},
			{
				title: 'Acompanhamento da obra',
				paragraphs: [construtoraName
					? `Acompanhe o andamento da obra junto à <strong>${construtoraName}</strong>.`
					: 'Acompanhe o andamento da obra com a <strong>incorporadora</strong>.'],
			},
		],
	},
	{
		title: 'Depois da entrega',
		intro: `Ao receber as chaves do <strong>${propertyTitle}</strong>, você quita o saldo devedor, registra a escritura no cartório de <strong>${city}</strong> e exerce a posse com todas as garantias legais da entrega.`,
		image: {
			src: '/images/vivercatarina/depois-da-entrega-na-planta.webp',
			alt: `Casal recebendo as chaves do ${propertyTitle} no lobby do prédio recém-entregue`,
		},
		items: [
			{
				title: 'Entrega das chaves',
				paragraphs: ['Receba as chaves com o <strong>Habite-se</strong> em dia.'],
			},
			{
				title: 'Quitação e registro',
				paragraphs: [`Quite o saldo e registre a escritura no cartório de <strong>${city}</strong>.`],
			},
			{
				title: 'Garantias legais',
				paragraphs: ['Acione as garantias legais nos prazos previstos em lei.'],
			},
		],
	},
];

const numberedGroups = groups.map((group, groupIndex) => ({
	title: group.title,
	intro: group.intro,
	image: group.image,
	phase: groupIndex + 1,
	items: group.items,
}));
---

<section
	class={`section property-offplan-guide${useSplitLayout ? ' property-offplan-guide--split' : ''}`}
	id="compra-na-planta"
>
	<h2 class="section__title landing-section-title">
		{toTitleCase('Como funciona a compra de um imóvel na planta?')}
	</h2>

	<p class="about-text" set:html={construtoraName
		? `A compra do <strong>${propertyTitle}</strong> na planta segue etapas próprias, bem diferentes de um imóvel pronto. O comprador reserva o apartamento, formaliza <strong>proposta e contrato</strong> com a <strong>${construtoraName}</strong>, acompanha a obra e só recebe as chaves após a entrega — com <strong>pagamentos distribuídos</strong> ao longo desse período.`
		: `A compra do <strong>${propertyTitle}</strong> na planta segue etapas próprias, bem diferentes de um imóvel pronto. O comprador reserva o apartamento, formaliza <strong>proposta e contrato</strong>, acompanha a obra e só recebe as chaves após a entrega — com <strong>pagamentos distribuídos</strong> ao longo desse período.`
	} />

	<p class="about-text" set:html={`Conhecer esse fluxo ajuda a planejar o orçamento, prever correções como o <strong>INCC</strong>, conferir a documentação da <strong>incorporadora</strong> e fechar negócio com mais segurança. Abaixo, resumimos as três fases do processo de compra do <strong>${propertyTitle}</strong> em <strong>${neighborhood}</strong>.`} />

	{
		numberedGroups.map((group, index) =>
			useSplitLayout ? (
				<div class="property-offplan-guide__group property-offplan-guide__group--split">
					<div class="property-offplan-guide__group-header">
						<h3 class="property-offplan-guide__group-title landing-section-title">
							<span class="property-offplan-guide__phase" aria-hidden="true">{group.phase}</span>
							{toTitleCase(group.title)}
						</h3>
						<p class="property-offplan-guide__group-intro" set:html={group.intro} />
					</div>
					<div class="property-offplan-guide__group-body">
						{
							group.image && (
								<figure class="property-offplan-guide__group-image property-offplan-guide__group-media">
									<img
										src={group.image.src}
										alt={group.image.alt}
										loading="lazy"
										decoding="async"
									/>
								</figure>
							)
						}
						<div class="property-offplan-guide__steps">
							{
								group.items.map((item) => (
									<article class="property-offplan-guide__item">
										<h4 class="property-offplan-guide__item-title">
											<span class="property-offplan-guide__step" aria-hidden="true">
												<i class="fa-solid fa-check"></i>
											</span>
											<span class="property-offplan-guide__item-label">{item.title}</span>
										</h4>
										{item.paragraphs.map((paragraph) => (
											<p set:html={paragraph} />
										))}
									</article>
								))
							}
						</div>
					</div>
				</div>
			) : (
				<div class="property-offplan-guide__group">
					<h3 class="property-offplan-guide__group-title landing-section-title">
						<span class="property-offplan-guide__phase" aria-hidden="true">{group.phase}</span>
						{toTitleCase(group.title)}
					</h3>
					<p class="property-offplan-guide__group-intro" set:html={group.intro} />
					{
						group.image && (
							<figure class="property-offplan-guide__group-image">
								<img src={group.image.src} alt={group.image.alt} loading="lazy" decoding="async" />
							</figure>
						)
					}
					<div class="property-offplan-guide__grid">
						{
							group.items.map((item) => (
								<article class="property-offplan-guide__item">
									<h4 class="property-offplan-guide__item-title">
										<span class="property-offplan-guide__step" aria-hidden="true">
											<i class="fa-solid fa-check"></i>
										</span>
										<span class="property-offplan-guide__item-label">{item.title}</span>
									</h4>
									{item.paragraphs.map((paragraph) => (
										<p set:html={paragraph} />
									))}
								</article>
							))
						}
					</div>
				</div>
			),
		)
	}

	{
		useSplitLayout && (
			<PropertyOffPlanGuideDownloadCta propertySlug={propertySlug} propertyTitle={propertyTitle} />
		)
	}
</section>

{
	useSplitLayout && (
		<script>
			function syncPropertyOffplanGuideStepsWidth() {
				const section = document.querySelector('.property-offplan-guide--split');

				if (!section) {
					return;
				}

				const steps = [...section.querySelectorAll('.property-offplan-guide__steps')];
				const items = [...section.querySelectorAll('.property-offplan-guide__steps .property-offplan-guide__item')];

				if (!steps.length) {
					return;
				}

				const isMobile = window.matchMedia('(max-width: 899px)').matches;

				section.style.removeProperty('--offplan-guide-steps-width');

				if (isMobile) {
					return;
				}

				items.forEach((item) => {
					item.style.setProperty('width', 'max-content', 'important');
					item.style.setProperty('min-width', 'max-content', 'important');
				});

				let maxWidth = 0;

				items.forEach((item) => {
					maxWidth = Math.max(maxWidth, item.getBoundingClientRect().width);
				});

				items.forEach((item) => {
					item.style.removeProperty('width');
					item.style.removeProperty('min-width');
				});

				if (maxWidth <= 0) {
					return;
				}

				section.style.setProperty('--offplan-guide-steps-width', `${Math.ceil(maxWidth)}px`);
			}

			const runSync = () => {
				requestAnimationFrame(() => {
					requestAnimationFrame(syncPropertyOffplanGuideStepsWidth);
				});
			};

			if (document.readyState === 'loading') {
				document.addEventListener('DOMContentLoaded', runSync, { once: true });
			} else {
				runSync();
			}

			window.addEventListener('resize', runSync);
			document.fonts?.ready?.then(runSync);

			const section = document.querySelector('.property-offplan-guide--split');

			if (section && 'ResizeObserver' in window) {
				const observer = new ResizeObserver(runSync);
				observer.observe(section);
			}
		</script>
	)
}

---
const { propertySlug = null, propertyTitle = null } = Astro.props;
---

<div class="property-regularity-guide__download-wrap">
	<button type="button" class="property-regularity-guide__download-card" data-regularity-checklist-open>
		<div class="property-regularity-guide__download-visual" aria-hidden="true">
			<svg
				class="property-regularity-guide__download-illustration"
				viewBox="0 0 120 150"
				fill="none"
				xmlns="http://www.w3.org/2000/svg"
			>
				<rect x="24" y="16" width="72" height="96" rx="8" fill="#fff" stroke="#d8dde5" stroke-width="2"></rect>
				<rect x="30" y="24" width="60" height="10" rx="3" fill="#FFAF00"></rect>
				<rect x="34" y="42" width="10" height="10" rx="2" fill="#FFAF00"></rect>
				<path d="M48 49l4 4 10-12" stroke="#FFAF00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
				<rect x="34" y="58" width="10" height="10" rx="2" fill="#f4f5f7" stroke="#e5e8ec" stroke-width="1.5"></rect>
				<rect x="48" y="61" width="34" height="4" rx="2" fill="#eceff3"></rect>
				<rect x="34" y="74" width="10" height="10" rx="2" fill="#f4f5f7" stroke="#e5e8ec" stroke-width="1.5"></rect>
				<rect x="48" y="77" width="30" height="4" rx="2" fill="#eceff3"></rect>
				<rect x="34" y="90" width="10" height="10" rx="2" fill="#f4f5f7" stroke="#e5e8ec" stroke-width="1.5"></rect>
				<rect x="48" y="93" width="36" height="4" rx="2" fill="#eceff3"></rect>
				<path d="M60 112c0 8-12 18-12 18S36 120 36 112a12 12 0 1 1 24 0z" fill="#fff" stroke="#FFAF00" stroke-width="2.5"></path>
				<path d="M54 112l4 4 8-10" stroke="#FFAF00" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
			</svg>
		</div>
		<span class="property-regularity-guide__download-content">
			<span class="property-regularity-guide__download-badge">Checklist gratuito</span>
			<span class="property-regularity-guide__download-title">
				Checklist completo de verificação de regularidade
			</span>
			<span class="property-regularity-guide__download-text">
				Material exclusivo com todos os itens que você precisa verificar antes de comprar um imóvel na planta.
			</span>
			<span class="property-regularity-guide__download-action">
				Baixar agora
				<i class="fa-solid fa-arrow-down" aria-hidden="true"></i>
			</span>
		</span>
	</button>
</div>

<div
	id="regularity-checklist-modal"
	class="whatsapp-lead-modal regularity-checklist-modal"
	hidden
>
	<div class="whatsapp-lead-modal__backdrop" data-regularity-checklist-close></div>
	<div
		class="whatsapp-lead-modal__dialog"
		role="dialog"
		aria-modal="true"
		aria-labelledby="regularity-checklist-title"
	>
		<button type="button" class="whatsapp-lead-modal__close" data-regularity-checklist-close aria-label="Fechar">
			&times;
		</button>
		<h2 id="regularity-checklist-title" class="whatsapp-lead-modal__title">Baixar checklist de regularidade</h2>
		<p class="whatsapp-lead-modal__text">Informe seus dados para receber o material completo.</p>
		<form id="regularity-checklist-form" class="whatsapp-lead-modal__form" novalidate>
			<label for="regularity-checklist-name">Nome</label>
			<input
				id="regularity-checklist-name"
				name="name"
				type="text"
				autocomplete="name"
				placeholder="Seu nome"
				required
			/>
			<label for="regularity-checklist-phone">Telefone</label>
			<input
				id="regularity-checklist-phone"
				name="phone"
				type="tel"
				autocomplete="tel"
				inputmode="tel"
				placeholder="+55 48 99999-9999"
				required
			/>
			<label for="regularity-checklist-email">E-mail</label>
			<input
				id="regularity-checklist-email"
				name="email"
				type="email"
				autocomplete="email"
				inputmode="email"
				placeholder="seu@email.com"
				required
			/>
			<p id="regularity-checklist-error" class="whatsapp-lead-modal__error" hidden></p>
			<button type="submit" class="whatsapp-lead-modal__submit">Baixar checklist</button>
		</form>
		<div id="regularity-checklist-success" class="regularity-checklist-modal__success" hidden>
			<p>Obrigado! Em breve você receberá o checklist no seu e-mail.</p>
			<button type="button" class="regularity-checklist-modal__done" data-regularity-checklist-close>Fechar</button>
		</div>
	</div>
</div>

<style is:global>
	#regularity-checklist-modal.whatsapp-lead-modal {
		position: fixed;
		inset: 0;
		z-index: 10000;
		display: grid;
		place-items: center;
		padding: 1rem;
	}

	#regularity-checklist-modal.whatsapp-lead-modal[hidden] {
		display: none;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__backdrop {
		position: absolute;
		inset: 0;
		background: rgba(3, 6, 14, 0.62);
	}

	#regularity-checklist-modal .whatsapp-lead-modal__dialog {
		position: relative;
		width: min(100%, 26rem);
		padding: 1.5rem;
		border-radius: 0;
		background: #fff;
		box-shadow: 0 24px 48px rgba(3, 6, 14, 0.18);
	}

	#regularity-checklist-modal .whatsapp-lead-modal__close {
		position: absolute;
		top: 0.75rem;
		right: 0.75rem;
		border: 0;
		background: transparent;
		font-size: 1.75rem;
		line-height: 1;
		color: #667085;
		cursor: pointer;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__title {
		margin: 0 0 0.5rem;
		font-size: 1.25rem;
		color: var(--title-color, #03060e);
	}

	#regularity-checklist-modal .whatsapp-lead-modal__text {
		margin: 0 0 1.25rem;
		color: var(--body-color, #667085);
		font-size: 0.95rem;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__form {
		display: grid;
		gap: 0.65rem;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__form label {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--title-color, #03060e);
	}

	#regularity-checklist-modal .whatsapp-lead-modal__form input {
		width: 100%;
		padding: 0.75rem 0.875rem;
		border: 1px solid var(--th-border-color, #e5e8ec);
		border-radius: 0;
		font: inherit;
		box-sizing: border-box;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__form input:focus {
		outline: 2px solid color-mix(in srgb, var(--theme-color2, #ffaf00) 35%, transparent);
		border-color: var(--theme-color2, #ffaf00);
	}

	#regularity-checklist-modal .whatsapp-lead-modal__error {
		margin: 0;
		color: #c0392b;
		font-size: 0.875rem;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__submit {
		margin-top: 0.35rem;
		border: 0;
		border-radius: 999px;
		padding: 0.85rem 1rem;
		background: var(--theme-color2, #ffaf00);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}

	#regularity-checklist-modal .whatsapp-lead-modal__submit:disabled {
		opacity: 0.7;
		cursor: wait;
	}

	#regularity-checklist-modal .regularity-checklist-modal__success {
		display: grid;
		gap: 1rem;
	}

	#regularity-checklist-modal .regularity-checklist-modal__success p {
		margin: 0;
		color: var(--body-color, #667085);
		font-size: 0.95rem;
		line-height: 1.5;
	}

	#regularity-checklist-modal .regularity-checklist-modal__done {
		border: 0;
		border-radius: 999px;
		padding: 0.85rem 1rem;
		background: var(--theme-color2, #ffaf00);
		color: #fff;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
</style>

<script define:vars={{ propertySlug, propertyTitle }}>
	const modal = document.getElementById('regularity-checklist-modal');
	const form = document.getElementById('regularity-checklist-form');
	const successBox = document.getElementById('regularity-checklist-success');
	const nameInput = document.getElementById('regularity-checklist-name');
	const phoneInput = document.getElementById('regularity-checklist-phone');
	const emailInput = document.getElementById('regularity-checklist-email');
	const errorBox = document.getElementById('regularity-checklist-error');
	const submitButton = form?.querySelector('[type="submit"]');
	const openButton = document.querySelector('[data-regularity-checklist-open]');

	const PHONE_PREFIX = '+55 ';

	function formatPhoneMask(value) {
		let digits = String(value || '').replace(/\D/g, '');

		if (digits.startsWith('55')) {
			digits = digits.slice(2);
		}

		digits = digits.slice(0, 11);

		if (digits.length === 0) {
			return PHONE_PREFIX;
		}

		let formatted = `${PHONE_PREFIX}${digits.slice(0, 2)}`;

		if (digits.length <= 2) {
			return formatted;
		}

		const number = digits.slice(2);

		if (number.length <= 5) {
			return `${formatted} ${number}`;
		}

		return `${formatted} ${number.slice(0, 5)}-${number.slice(5, 9)}`;
	}

	function resetPhoneInput() {
		if (phoneInput) {
			phoneInput.value = PHONE_PREFIX;
		}
	}

	function showForm() {
		form.hidden = false;
		successBox.hidden = true;
	}

	function showSuccess() {
		form.hidden = true;
		successBox.hidden = false;
	}

	function openModal() {
		if (!modal || !form) {
			return;
		}

		errorBox.hidden = true;
		errorBox.textContent = '';
		form.reset();
		resetPhoneInput();
		showForm();
		modal.hidden = false;
		modal.setAttribute('aria-hidden', 'false');
		nameInput?.focus();
		document.body.style.overflow = 'hidden';
	}

	function closeModal() {
		if (!modal) {
			return;
		}

		modal.hidden = true;
		modal.setAttribute('aria-hidden', 'true');
		document.body.style.overflow = '';
	}

	function showError(message) {
		if (!errorBox) {
			return;
		}

		errorBox.textContent = message;
		errorBox.hidden = false;
	}

	openButton?.addEventListener('click', openModal);

	modal?.querySelectorAll('[data-regularity-checklist-close]').forEach((element) => {
		element.addEventListener('click', closeModal);
	});

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && modal && !modal.hidden) {
			closeModal();
		}
	});

	phoneInput?.addEventListener('input', () => {
		if (!phoneInput) {
			return;
		}

		phoneInput.value = formatPhoneMask(phoneInput.value);
	});

	phoneInput?.addEventListener('keydown', (event) => {
		if (!phoneInput) {
			return;
		}

		const { selectionStart, selectionEnd } = phoneInput;

		if (
			(event.key === 'Backspace' || event.key === 'Delete') &&
			selectionStart !== null &&
			selectionEnd !== null &&
			selectionStart <= PHONE_PREFIX.length &&
			selectionEnd <= PHONE_PREFIX.length
		) {
			event.preventDefault();
		}
	});

	phoneInput?.addEventListener('focus', () => {
		if (!phoneInput?.value || phoneInput.value === '+55') {
			resetPhoneInput();
		}
	});

	resetPhoneInput();

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();

		if (!submitButton) {
			return;
		}

		errorBox.hidden = true;
		errorBox.textContent = '';
		submitButton.disabled = true;

		try {
			const response = await fetch('/api/whatsapp-leads.php', {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({
					name: nameInput?.value,
					phone: phoneInput?.value,
					email: emailInput?.value,
					source: 'regularity-checklist-download',
					pageUrl: window.location.href,
					propertySlug,
					propertyTitle,
				}),
			});

			const payload = await response.json();

			if (!response.ok) {
				showError(payload.error || 'Não foi possível enviar seus dados. Tente novamente.');
				return;
			}

			showSuccess();
		} catch {
			showError('Erro de conexão. Verifique sua internet e tente novamente.');
		} finally {
			submitButton.disabled = false;
		}
	});
</script>

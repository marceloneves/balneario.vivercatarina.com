---
import { toTitleCase } from '../lib/title-case.mjs';

const { construtora } = Astro.props;

if (!construtora?.paragraphs?.length) {
	return null;
}
---

<section class="section property-construtora">
	<h2 class="section__title landing-section-title">{toTitleCase('A construtora')}</h2>
	{construtora.paragraphs.map((paragraph) => (
		<p class="about-text" set:html={paragraph} />
	))}
</section>

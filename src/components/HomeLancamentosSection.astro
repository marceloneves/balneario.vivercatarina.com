---
const { properties } = Astro.props;

const DIACRITIC_RE = /\p{M}/gu;
function normalizeSearchText(str: string): string {
	return (str || '').toLowerCase().normalize('NFD').replace(DIACRITIC_RE, '');
}
---

<section class="popular-sec-1 home-lancamentos-section overflow-hidden space" aria-labelledby="home-lancamentos-title">
	<div class="container">
		<div class="row justify-content-center">
			<div class="col-xl-10">
				<div class="title-area text-center mb-4">
					<p class="sub-title"><span class="double-line"></span> Lançamentos</p>
					<h2 class="sec-title mb-4 bairro-listing-title" id="home-lancamentos-title">Imóveis na planta em <span class="bairro-name-accent">Balneário Camboriú</span></h2>
					<p class="mt-n2 mb-4">Confira os melhores lançamentos imobiliários da cidade de Balneário Camboriú - SC</p>
				</div>
			</div>
		</div>

		<div class="row gy-30 justify-content-start home-lancamentos-section__grid">
			{
				properties.length === 0 ? (
					<div class="col-12">
						<p class="text-center mb-0">Nenhum lançamento disponível no momento.</p>
					</div>
				) : (
					properties.map((property) => (
						<div
							class={`col-xxl-3 col-xl-4 col-lg-6 col-md-6 filter-item ${property.kindFilterClass} ${property.neighborhoodFilterClass || ''} ${property.construtoraFilterClass || ''} ${property.isFeatured ? '' : 'is-filtered-out'}`.trim()}
							data-featured={property.isFeatured ? 'true' : 'false'}
							data-price={property.price ?? 0}
							data-search-text={normalizeSearchText(property.title ?? '')}
						>
							<article class="popular-list-1 h-100">
								<div class="thumb-wrapper">
									<a href={property.detailUrl} class="thumb-link">
										<img
											src={property.imageUrl}
											srcset={property.imageSrcset ?? undefined}
											sizes={property.imageSizes ?? undefined}
											alt={property.imageAlt ?? property.title}
											title={property.imageTitle ?? property.title}
											width="400"
											height="300"
											loading="lazy"
											decoding="async"
										/>
										<div class="popular-badge">
											<img src="/assets/img/icon/sell_rent_icon.svg" alt="" aria-hidden="true" />
											<p>{property.categoryLabel}</p>
										</div>
									</a>
								</div>
								<div class="property-content">
									<div class="media-body">
										<h3 class="box-title">
											<a href={property.detailUrl}>{property.title}</a>
										</h3>
										<div class="box-text">
											<div class="icon">
												<img src="/assets/img/icon/popular-location.svg" alt="" aria-hidden="true" />
											</div>
											{property.locationLabel}
										</div>
									</div>

									<ul class="property-featured">
										{property.bedrooms != null && (
											<li>
												<div class="icon">
													<img src="/assets/img/icon/bed.svg" alt="" aria-hidden="true" />
												</div>
												Quartos {property.bedrooms}
											</li>
										)}
										{property.bathrooms != null && (
											<li>
												<div class="icon">
													<img src="/assets/img/icon/bath.svg" alt="" aria-hidden="true" />
												</div>
												Banheiros {property.bathrooms}
											</li>
										)}
										{property.sizeSqm != null && (
											<li>
												<div class="icon">
													<img src="/assets/img/icon/sqft.svg" alt="" aria-hidden="true" />
												</div>
												{property.sizeSqm} m²
											</li>
										)}
									</ul>
									<div class="property-bottom">
										<p class="box-title property-price">{property.priceLabel}</p>
										<a class="th-btn sm style3 pill" href={property.detailUrl}>
											Ver mais
										</a>
									</div>
								</div>
							</article>
						</div>
					))
				)
			}
		</div>

		<div class="home-lancamentos-section__empty text-center d-none mt-40" data-home-lancamentos-empty>
			<p class="mb-0">Nenhum lançamento encontrado com os filtros selecionados.</p>
		</div>

		{
			properties.length > 0 && (
				<div class="text-center mt-40">
					<a href="/lancamentos/apartamentos" class="th-btn pill home-lancamentos-section__all-btn">
						Ver todos os lançamentos
					</a>
				</div>
			)
		}
	</div>
</section>

<style>
	.home-lancamentos-section .filter-item {
		display: flex;
	}

	.home-lancamentos-section .filter-item.is-filtered-out {
		display: none !important;
	}

	.home-lancamentos-section .popular-list-1 {
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	.home-lancamentos-section .thumb-wrapper {
		flex-shrink: 0;
		max-height: none;
		aspect-ratio: 4 / 3;
		height: auto;
	}

	.home-lancamentos-section .thumb-wrapper .thumb-link {
		display: block;
		position: relative;
		height: 100%;
	}

	.home-lancamentos-section .thumb-wrapper .thumb-link > img {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: center;
		border-radius: 16px 16px 0 0;
	}

	.home-lancamentos-section .thumb-wrapper .popular-badge {
		z-index: 4;
	}

	.home-lancamentos-section .thumb-wrapper .popular-badge p {
		border-radius: 0;
	}

	.home-lancamentos-section .thumb-wrapper .popular-badge img {
		position: absolute;
		top: -24px;
		left: 50%;
		transform: translateX(-50%);
		width: 54px;
		height: 30px;
		max-width: 54px;
		object-fit: contain;
		border-radius: 0;
	}

	.home-lancamentos-section .property-content {
		display: flex;
		flex: 1;
		flex-direction: column;
		/* Mesmo creme dos cards de bairro, só na área de texto do card. */
		background: #F5F2ED;
	}

	.home-lancamentos-section .media-body .box-title {
		display: -webkit-box;
		min-height: 3.25rem;
		overflow: hidden;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		line-clamp: 2;
	}

	.home-lancamentos-section .property-featured {
		align-items: center;
		min-height: 3.25rem;
	}

	.home-lancamentos-section .property-bottom {
		margin-top: auto;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 16px;
	}

	.home-lancamentos-section__all-btn {
		padding: 14px 28px;
		font-size: 15px;
		font-weight: 600;
	}

	/* Botão "Ver mais" dos cards: fundo amarelo; no hover vira fundo preto. */
	.home-lancamentos-section .popular-list-1 .th-btn {
		background-color: var(--theme-color) !important;
		border-color: var(--theme-color) !important;
		color: var(--title-color) !important;
	}
	.home-lancamentos-section .popular-list-1 .th-btn::before,
	.home-lancamentos-section .popular-list-1 .th-btn::after {
		background-color: var(--title-color) !important;
	}
	.home-lancamentos-section .popular-list-1 .th-btn:hover,
	.home-lancamentos-section .popular-list-1 .th-btn:focus-visible {
		background-color: var(--title-color) !important;
		border-color: var(--title-color) !important;
		color: var(--theme-color) !important;
	}

</style>

<script>
	const KIND_FILTER_CLASS = {
		apartamento: 'cat-apartamento',
		casa: 'cat-casa',
		loteamento: 'cat-loteamento',
	};

	function initHomeLancamentosFilter() {
		const section = document.querySelector('.home-lancamentos-section');

		if (!section || section.dataset.filterReady === 'true') {
			return;
		}

		section.dataset.filterReady = 'true';

		const items = section.querySelectorAll('.filter-item');
		const emptyState = section.querySelector('[data-home-lancamentos-empty]');

		document.addEventListener('home-property-filter', (event) => {
			const { kind, neighborhood, construtora, priceMin = 0, search = '' } = event.detail;
			const normalizedSearch = search.toLowerCase().normalize('NFD').replace(/\p{M}/gu, '');
			const hasFilter = Boolean(kind || neighborhood || construtora || priceMin > 0 || normalizedSearch);
			let visibleCount = 0;

			items.forEach((item) => {
				let isVisible;

				if (!hasFilter) {
					isVisible = item.dataset.featured === 'true';
				} else {
					const matchesKind = !kind || item.classList.contains(KIND_FILTER_CLASS[kind]);
					const matchesNeighborhood = !neighborhood || item.classList.contains(`bairro-${neighborhood}`);
					const matchesConstrutora = !construtora || item.classList.contains(`construtora-${construtora}`);
					const matchesPrice = priceMin <= 0 || Number(item.dataset.price) >= priceMin;
					const matchesSearch = !normalizedSearch || (item.dataset.searchText || '').includes(normalizedSearch);
					isVisible = matchesKind && matchesNeighborhood && matchesConstrutora && matchesPrice && matchesSearch;
				}

				item.classList.toggle('is-filtered-out', !isVisible);

				if (isVisible) {
					visibleCount += 1;
				}
			});

			if (emptyState) {
				emptyState.classList.toggle('d-none', visibleCount > 0);
				emptyState.classList.toggle('mt-40', visibleCount === 0);
			}

			section.scrollIntoView({ behavior: 'smooth', block: 'start' });
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHomeLancamentosFilter, { once: true });
	} else {
		initHomeLancamentosFilter();
	}
</script>

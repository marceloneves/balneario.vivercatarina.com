---
import PillerLayout from '../layouts/PillerLayout.astro';
import PropertyLandingPageViverCatarina from './PropertyLandingPageViverCatarina.astro';
import { buildImovelPageContext } from '../lib/imovel-page.mjs';
import { versionedAsset } from '../lib/asset-version.mjs';

const { slug } = Astro.props;
const page = buildImovelPageContext(slug);

	if (!page) {
		return Astro.redirect('/404');
	}

const breadcrumbParent = page.neighborhoodSlug
	? { href: `/bairro/${page.neighborhoodSlug}`, label: page.nav.neighborhood }
	: { href: '/lancamentos/apartamentos', label: 'Lançamentos' };
---

<PillerLayout
	title={page.seo.title}
	description={page.seo.description}
	keywords={page.seo.keywords}
	ogImage={page.seo.ogImage}
	canonicalPath={`/imovel/${page.slug}`}
	bodyClass="imovel-landing imovel-landing-vivercatarina"
	disableEffects
	asyncFonts
	slimScripts
	preloadImage={page.hero.images[0]?.lcpUrl}
	breadcrumb={[
		{ name: 'Início', url: '/' },
		{ name: breadcrumbParent.label, url: breadcrumbParent.href },
		{ name: page.nav.title, url: `/imovel/${page.slug}` },
	]}
>
	<Fragment slot="head">
		<link rel="stylesheet" href={versionedAsset('/css/imovel-landing.css')} />
		<link rel="stylesheet" href={versionedAsset('/css/imovel-landing-vivercatarina.css')} />
		{page.seo.jsonLd && <script type="application/ld+json" set:html={JSON.stringify(page.seo.jsonLd)} />}
	</Fragment>

	<Fragment set:html={page.shellBefore} />
	<PropertyLandingPageViverCatarina page={page} breadcrumbParent={breadcrumbParent} />
	<Fragment set:html={page.shellAfter} />
</PillerLayout>

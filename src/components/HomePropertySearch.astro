---
import HomePropertyFilterFields from './HomePropertyFilterFields.astro';

const { kinds, neighborhoods, construtoras = [] } = Astro.props;
---

<section class="search-area" aria-label="Busca de imóveis">
	<form class="home-property-search" role="search" data-home-property-search>
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-xxl-10">
					<div class="search-wrap home-search-filter">
						<HomePropertyFilterFields
							kinds={kinds}
							neighborhoods={neighborhoods}
							construtoras={construtoras}
							idPrefix="home-search"
							showSubmit={true}
						/>
					</div>
				</div>
			</div>
		</div>
	</form>
</section>

<script>
	function initHomePropertySearch() {
		const form = document.querySelector('[data-home-property-search]');

		if (!form || form.dataset.searchReady === 'true') {
			return;
		}

		form.dataset.searchReady = 'true';

		form.addEventListener('submit', (event) => {
			event.preventDefault();

			const kind = form.querySelector('[name="kind"]')?.value || '';
			const neighborhood = form.querySelector('[name="neighborhood"]')?.value || '';
			const construtora = form.querySelector('[name="construtora"]')?.value || '';
			const priceMinRaw = Number(form.querySelector('[name="priceMin"]')?.value) || 0;
			const priceMinEl = form.querySelector<HTMLInputElement>('[name="priceMin"]');
			const priceMin = priceMinEl && priceMinRaw > Number(priceMinEl.min) ? priceMinRaw : 0;
			const search = (form.querySelector('[name="search"]')?.value || '').trim();

			document.dispatchEvent(
				new CustomEvent('home-property-filter', {
					detail: { kind, neighborhood, construtora, priceMin, search },
				}),
			);
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', initHomePropertySearch, { once: true });
	} else {
		initHomePropertySearch();
	}
</script>

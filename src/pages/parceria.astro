---
import PillerLayout from '../layouts/PillerLayout.astro';
import PartnerContactForm from '../components/PartnerContactForm.astro';
import bodyHtml from '../content/template-pages/quem-somos.html?raw';
import { removeBreadcrumbTitle, stripBreadcrumbHero } from '../lib/listing-breadcrumb.mjs';
import { applySemanticHtml, wrapSplitPageContent } from '../lib/semantic-html.mjs';
import { patchSiteMenu } from '../lib/site-menu.mjs';

const title = 'Quero ser parceiro';
const description =
	'Fale com o Viver Catarina para ser parceiro: incorporadoras, construtoras, imobiliárias e corretores de imóveis em Balneário Camboriú.';
const bodyClass = '';

const aboutAreaStart = bodyHtml.indexOf('<!--==============================\nAbout Area');
const footerStart = bodyHtml.indexOf('<!--==============================\n\tFooter Area');

if (aboutAreaStart === -1 || footerStart === -1) {
	throw new Error('Não foi possível montar a página de parceria a partir do template.');
}

const headerHtml = patchSiteMenu(
	applySemanticHtml(bodyHtml.slice(0, aboutAreaStart)),
	'/seja-um-parceiro',
).replace(
	'<span aria-current="page">Quem Somos</span>',
	'<span aria-current="page">Quero ser parceiro</span>',
);

const shell = wrapSplitPageContent(
	stripBreadcrumbHero(removeBreadcrumbTitle(headerHtml)),
	applySemanticHtml(bodyHtml.slice(footerStart)),
);
---

<PillerLayout title={title} description={description} bodyClass={bodyClass}>
	<Fragment set:html={shell.before} />
	<PartnerContactForm />
	<Fragment set:html={shell.after} />
</PillerLayout>
